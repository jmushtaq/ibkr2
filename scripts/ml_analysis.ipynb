# %% [markdown]
# # Financial Machine Learning Analysis
# ## Interactive analysis using the ML Framework

# %%
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.graph_objects as go
import plotly.express as px
from plotly.subplots import make_subplots
import warnings
warnings.filterwarnings('ignore')

# Setup Django environment
import os
import sys
import django

sys.path.append('..')
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'ibkr_project.settings')
django.setup()

from markets.models import Symbol, OHLCVData
from ml_framework.models import MLDataset, MLModel, BacktestResult, Prediction
from ml_framework.dataset_manager import MLDatasetManager
from ml_framework.model_trainer import ModelTrainer
from ml_framework.backtest import Backtester

# %%
# Set plotting style
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette("husl")

# %%
# 1. Load and Explore Data
symbol = Symbol.objects.get(ticker='AAPL')
frequency = '1D'

# Load OHLCV data
ohlcv_records = OHLCVData.objects.filter(symbol=symbol, frequency=frequency).order_by('year')
dfs = [record.get_data_as_dataframe() for record in ohlcv_records]
data = pd.concat(dfs).sort_index()

print(f"Data range: {data.index[0]} to {data.index[-1]}")
print(f"Total rows: {len(data)}")
print(f"Columns: {data.columns.tolist()}")

# %%
# Plot price and volume
fig = make_subplots(
    rows=2, cols=1,
    shared_xaxes=True,
    vertical_spacing=0.03,
    row_heights=[0.7, 0.3]
)

# Candlestick chart
fig.add_trace(go.Candlestick(
    x=data.index,
    open=data['open'],
    high=data['high'],
    low=data['low'],
    close=data['close'],
    name='AAPL'
), row=1, col=1)

# Volume
fig.add_trace(go.Bar(
    x=data.index,
    y=data['volume'],
    name='Volume',
    marker_color='lightblue'
), row=2, col=1)

fig.update_layout(
    title='AAPL Stock Price and Volume',
    yaxis_title='Price ($)',
    yaxis2_title='Volume',
    xaxis_title='Date',
    template='plotly_dark'
)

fig.show()

# %%
# 2. Feature Engineering Analysis
manager = MLDatasetManager(
    data=data,
    symbol='AAPL',
    frequency='1D'
)

# Generate features
feature_config = {'all': True}
dataset = manager.create_dataset(
    feature_config=feature_config,
    label_config={'type': 'binary', 'lookahead': '1d', 'threshold': 0.005},
    name="AAPL_analysis",
    description="Temporary dataset for analysis"
)

print(f"Generated {len(dataset.columns)} features")
print(f"Feature names: {dataset.columns.tolist()[:10]}...")

# %%
# Feature correlation analysis
correlation_matrix = dataset.corr()

plt.figure(figsize=(12, 10))
sns.heatmap(
    correlation_matrix,
    cmap='coolwarm',
    center=0,
    square=True,
    annot=False,
    cbar_kws={'shrink': 0.8}
)
plt.title('Feature Correlation Matrix')
plt.tight_layout()
plt.show()

# %%
# Top correlations with target
target_corr = correlation_matrix['label'].abs().sort_values(ascending=False)
top_features = target_corr[1:21]  # Top 20 excluding label

plt.figure(figsize=(10, 8))
top_features.plot(kind='barh')
plt.xlabel('Absolute Correlation')
plt.title('Top 20 Features Correlated with Target')
plt.tight_layout()
plt.show()

# %%
# 3. Train and Compare Models
# Split data
train_df, val_df, test_df = manager.split_data(dataset, test_size=0.2, validation_size=0.1, time_based=True)

print(f"Train: {len(train_df)} samples")
print(f"Validation: {len(val_df)} samples")
print(f"Test: {len(test_df)} samples")

# %%
# Train multiple models
feature_names = [col for col in train_df.columns if col != 'label']
trainer = ModelTrainer(train_df, feature_names, 'label')

models = {}

# XGBoost
print("Training XGBoost...")
xgboost_result = trainer.train_xgboost(train_df=train_df, val_df=val_df)
models['XGBoost'] = xgboost_result
print(f"XGBoost Validation Accuracy: {xgboost_result['metrics']['accuracy']:.2%}")

# LightGBM
print("\nTraining LightGBM...")
lightgbm_result = trainer.train_lightgbm(train_df=train_df, val_df=val_df)
models['LightGBM'] = lightgbm_result
print(f"LightGBM Validation Accuracy: {lightgbm_result['metrics']['accuracy']:.2%}")

# Random Forest
print("\nTraining Random Forest...")
rf_result = trainer.train_random_forest(train_df=train_df, val_df=val_df)
models['Random Forest'] = rf_result
print(f"Random Forest Validation Accuracy: {rf_result['metrics']['accuracy']:.2%}")

# %%
# Compare model performance
metrics_df = pd.DataFrame({
    name: {
        'Accuracy': result['metrics']['accuracy'],
        'Precision': result['metrics']['precision'],
        'Recall': result['metrics']['recall'],
        'F1 Score': result['metrics']['f1_score']
    }
    for name, result in models.items()
}).T

print("Model Comparison:")
print(metrics_df)

# %%
# Plot model comparison
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
metrics_df.plot(kind='bar', ax=axes[0, 0])
axes[0, 0].set_title('Performance Metrics Comparison')
axes[0, 0].set_ylabel('Score')
axes[0, 0].legend(loc='lower right')

# Feature importance for best model
best_model_name = metrics_df['Accuracy'].idxmax()
best_model = models[best_model_name]
importance_df = pd.DataFrame(
    list(best_model['feature_importance'].items()),
    columns=['Feature', 'Importance']
).sort_values('Importance', ascending=False).head(20)

importance_df.plot(kind='barh', x='Feature', y='Importance', ax=axes[0, 1])
axes[0, 1].set_title(f'Top 20 Features - {best_model_name}')

# Learning curves (if available)
if hasattr(best_model['model'], 'evals_result'):
    evals_result = best_model['model'].evals_result()
    if 'validation_0' in evals_result:
        axes[1, 0].plot(evals_result['validation_0']['logloss'])
        axes[1, 0].set_title('Learning Curve')
        axes[1, 0].set_xlabel('Iterations')
        axes[1, 0].set_ylabel('Log Loss')

# Confusion matrix
from sklearn.metrics import confusion_matrix
X_val = val_df[feature_names].values
y_val = val_df['label'].values
y_pred = best_model['model'].predict(X_val)

cm = confusion_matrix(y_val, y_pred)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[1, 1])
axes[1, 1].set_title('Confusion Matrix')
axes[1, 1].set_xlabel('Predicted')
axes[1, 1].set_ylabel('Actual')

plt.tight_layout()
plt.show()

# %%
# 4. Backtest Strategy
backtester = Backtester(
    data=test_df,  # Use test data for out-of-sample backtest
    model=best_model['model'],
    feature_names=feature_names
)

# Run backtest with different configurations
backtest_configs = [
    {'name': 'Simple', 'position_size': 0.1, 'stop_loss': None, 'take_profit': None, 'min_confidence': 0.5},
    {'name': 'With Stops', 'position_size': 0.1, 'stop_loss': 0.02, 'take_profit': 0.04, 'min_confidence': 0.5},
    {'name': 'High Confidence', 'position_size': 0.1, 'stop_loss': 0.02, 'take_profit': 0.04, 'min_confidence': 0.7},
]

results = {}
for config in backtest_configs:
    result = backtester.run_backtest(
        initial_capital=100000,
        position_size=config['position_size'],
        stop_loss=config['stop_loss'],
        take_profit=config['take_profit'],
        min_confidence=config['min_confidence']
    )
    results[config['name']] = result

# %%
# Plot equity curves
fig = go.Figure()

for name, result in results.items():
    equity_curve = pd.DataFrame(result['equity_curve'])
    fig.add_trace(go.Scatter(
        x=equity_curve['date'],
        y=equity_curve['equity'],
        mode='lines',
        name=name
    ))

fig.update_layout(
    title='Equity Curves - Backtest Results',
    xaxis_title='Date',
    yaxis_title='Portfolio Value ($)',
    template='plotly_dark'
)
fig.show()

# %%
# Compare backtest metrics
backtest_metrics = pd.DataFrame({
    name: result['metrics']
    for name, result in results.items()
}).T

print("Backtest Metrics Comparison:")
print(backtest_metrics)

# %%
# 5. Analyze Trade Distribution
best_result = results[backtest_metrics['sharpe_ratio'].idxmax()]
trades_df = pd.DataFrame(best_result['trades'])

if not trades_df.empty:
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    
    # Trade returns distribution
    trades_df['return'].hist(bins=30, ax=axes[0, 0])
    axes[0, 0].set_title('Trade Returns Distribution')
    axes[0, 0].set_xlabel('Return')
    axes[0, 0].set_ylabel('Frequency')
    
    # Returns by direction
    trades_df.boxplot(column='return', by='direction', ax=axes[0, 1])
    axes[0, 1].set_title('Returns by Trade Direction')
    axes[0, 1].set_xlabel('Direction')
    axes[0, 1].set_ylabel('Return')
    
    # Cumulative returns
    trades_df['cumulative_return'] = (1 + trades_df['return']).cumprod() - 1
    trades_df['cumulative_return'].plot(ax=axes[1, 0])
    axes[1, 0].set_title('Cumulative Trade Returns')
    axes[1, 0].set_xlabel('Trade Number')
    axes[1, 0].set_ylabel('Cumulative Return')
    
    # Win rate by month
    trades_df['month'] = pd.to_datetime(trades_df['entry_date']).dt.to_period('M')
    monthly_win_rate = trades_df.groupby('month').apply(
        lambda x: (x['return'] > 0).mean()
    )
    monthly_win_rate.plot(kind='bar', ax=axes[1, 1])
    axes[1, 1].set_title('Monthly Win Rate')
    axes[1, 1].set_xlabel('Month')
    axes[1, 1].set_ylabel('Win Rate')
    
    plt.tight_layout()
    plt.show()

# %%
# 6. Feature Importance Analysis
importances = pd.DataFrame(best_model['feature_importance'].items(), columns=['Feature', 'Importance'])
importances = importances.sort_values('Importance', ascending=False)

# Top 30 features
top_features = importances.head(30)

plt.figure(figsize=(12, 10))
plt.barh(top_features['Feature'], top_features['Importance'])
plt.xlabel('Importance')
plt.title(f'Top 30 Features - {best_model_name}')
plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()

# %%
# 7. Analyze Predictions vs Actual
X_test = test_df[feature_names].values
y_test = test_df['label'].values
y_pred_prob = best_model['model'].predict_proba(X_test)[:, 1] if hasattr(best_model['model'], 'predict_proba') else None

if y_pred_prob is not None:
    # Create prediction analysis dataframe
    pred_analysis = pd.DataFrame({
        'actual': y_test,
        'pred_prob': y_pred_prob,
        'pred_class': (y_pred_prob > 0.5).astype(int)
    }, index=test_df.index)
    
    # Plot predictions over time
    fig = make_subplots(rows=2, cols=1)
    
    # Actual vs predicted
    fig.add_trace(go.Scatter(
        x=pred_analysis.index,
        y=pred_analysis['actual'],
        mode='markers',
        name='Actual',
        marker=dict(size=5)
    ), row=1, col=1)
    
    fig.add_trace(go.Scatter(
        x=pred_analysis.index,
        y=pred_analysis['pred_class'],
        mode='lines',
        name='Predicted',
        line=dict(color='red', width=1)
    ), row=1, col=1)
    
    # Prediction probabilities
    fig.add_trace(go.Scatter(
        x=pred_analysis.index,
        y=pred_analysis['pred_prob'],
        mode='lines',
        name='Prediction Probability',
        fill='tozeroy',
        line=dict(color='blue')
    ), row=2, col=1)
    
    fig.update_layout(
        title='Model Predictions vs Actual Labels',
        xaxis_title='Date',
        template='plotly_dark',
        height=800
    )
    
    fig.show()
    
    # Calibration plot
    from sklearn.calibration import calibration_curve
    
    prob_true, prob_pred = calibration_curve(y_test, y_pred_prob, n_bins=10)
    
    plt.figure(figsize=(8, 6))
    plt.plot(prob_pred, prob_true, marker='o', linewidth=2, label='Model')
    plt.plot([0, 1], [0, 1], linestyle='--', label='Perfect Calibration')
    plt.xlabel('Mean Predicted Probability')
    plt.ylabel('Fraction of Positives')
    plt.title('Calibration Plot')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.show()

# %%
# 8. Cross-Symbol Comparison
from ml_framework.models import MLModel, BacktestResult

# Get all active models with backtest results
models = MLModel.objects.filter(is_active=True, backtests__isnull=False).distinct()

comparison_data = []
for model in models:
    best_backtest = model.backtests.order_by('-sharpe_ratio').first()
    if best_backtest:
        comparison_data.append({
            'Symbol': model.dataset.symbol.ticker,
            'Model': model.algorithm,
            'Strategy': model.dataset.labeled_dataset.name,
            'Sharpe Ratio': best_backtest.sharpe_ratio,
            'Total Return': best_backtest.total_return,
            'Win Rate': best_backtest.win_rate,
            'Max Drawdown': best_backtest.max_drawdown,
            'Total Trades': best_backtest.total_trades
        })

if comparison_data:
    comparison_df = pd.DataFrame(comparison_data)
    comparison_df = comparison_df.sort_values('Sharpe Ratio', ascending=False)
    
    print("Best Performing Models Across Symbols:")
    print(comparison_df.head(10))
    
    # Visualize comparison
    fig = go.Figure()
    
    fig.add_trace(go.Bar(
        x=comparison_df['Symbol'] + ' (' + comparison_df['Model'] + ')',
        y=comparison_df['Sharpe Ratio'],
        name='Sharpe Ratio',
        marker_color='green'
    ))
    
    fig.add_trace(go.Scatter(
        x=comparison_df['Symbol'] + ' (' + comparison_df['Model'] + ')',
        y=comparison_df['Win Rate'] * 100,
        name='Win Rate (%)',
        yaxis='y2',
        mode='markers+lines',
        marker=dict(size=10)
    ))
    
    fig.update_layout(
        title='Model Performance Comparison',
        xaxis_title='Symbol (Model)',
        yaxis_title='Sharpe Ratio',
        yaxis2=dict(title='Win Rate (%)', overlaying='y', side='right'),
        template='plotly_dark',
        xaxis_tickangle=-45
    )
    
    fig.show()

# %%
print("Analysis Complete!")

